{
    // settings related to the physical machine
    "machine": {
        // written into a slicer's config header - purely descriptive, no effect on motion
        "printerModel": "Bambu Lab P1S",
        "maxHeight": 250, // mm

        "startPos": [128, 128, 9], // starting position of the nozzle
        "endPos": [128, 256], // final position of the nozzle
        "penOffset": [-38, 0], // position of the pen relative to the nozzle
        "plateSize": [256, 256], // size of the heatbed; lower-left corner is fixed at the origin
        "safeZoneSize": [217, 243], // size of the area the pen can safely move to without colliding
        "safeZoneOffset": [0, 0], // distance to shift the safe zone towards the plate's center, from safeZoneAlignment's corner being coincident with the matching plate corner
        "safeZoneAlignment": "TL", // which plate corner safeZoneOffset is measured from ("BL"/"BR"/"TL"/"TR")

        "canvasSize": [215.9, 243], // size of the paper/drawable surface - change this to change the paper size
        "canvasOffset": [0, 0], // distance to shift the canvas towards the plate's center, from canvasAlignment's corner being coincident with the matching plate corner
        "canvasAlignment": "TL", // which plate corner canvasOffset is measured from ("BL"/"BR"/"TL"/"TR")

        "maxVerticalSpeed": 15 // mm/s - max speed the printer's Z axis can move; the router assumes the slower of this and the travel speed when costing a travel's pen lift/lower time
    },

    // controls how the pen moves while drawing
    "motion": {
        // line types: draw (controls all drawing line types, can be overridden), "stroke", "infill", "gapInfill", "travel"
        "heights": {"draw": 2, "travel": 3.2}, // mm
        "speeds": {"draw": 200, "travel": 500}, // mm/s
        "accels": {"draw": 10000, "travel": 20000}, // mm/s^2
        "shortTravelThresholds": {"draw": 0.5, "infill": 1, "gapInfill": 1}, // travel moves below this distance (mm) will not lift the pen
        "loadDelay": 5, // wait this long for user to load pen
        "showLoadProgress": true, // if true, count the load delay down on the printer's progress display (100% -> 0%); if false, wait silently
        "eAxisMultiplier": 1 // scales every emitted E value - reduces the raw commanded E rate the P1S planner throttles XY speed against; side effect: the slicer's total-filament stat scales down by the same factor
    },

    // controls what is drawn on paper
    "processing": {
        // penWidth is the real pen's ink width; fillSpacing is the distance between
        // adjacent infill lines. Keep fillSpacing < penWidth. Real ink coverage varies
        // with pen pressure, nib wear, and paper texture.
        "penWidth": 0.32, // expected ink width (mm); also positions the first fill/stroke ring so the pen's real outer edge lands exactly on the true boundary
        "fillSpacing": 0.27, // max distance (mm) between adjacent passes/loops before white paper shows through; 0 disables fill
        "generateGapInfill": true, // if true, adds extra strokes to fill small gaps in the infill
        "generateStroke": true, // if false, strokes draw as a single centerline pass regardless of strokeWidth (the pre-multi-pass behavior) instead of expanding to multiple passes
        "tessellationTolerance": 0.012, // max allowed deviation (mm) of gcode from the true curve
        "showOutOfBounds": false, // if true, segments outside the canvas are still drawn, tagged as the "invalid" line type for slicer-preview visibility; if false (default), they're cropped to the canvas edge instead

        "calibrationTest": "none", // "none" draws SVGs normally; set to a calibration test's name instead (listed in README.md) to generate that test's sheet
        // options are "none", "height", "speed", "accel", "spacing"

        "machinePrefixFile": "gcode_templates/machines/bambu_p1s_prefix.gcode",
        "machineSuffixFile": "gcode_templates/machines/bambu_p1s_suffix.gcode"
    },

    // how the drawing renders in whichever slicer's preview - the slicer config only
    // supplies that slicer's own vocabulary (lineTypes/instructionTypes/segmentTypes,
    // styleChangeMessage/layerChangeMessage) for these choices to draw from
    "visualization": {
        "showPenPos": true, // if false, nozzle position will be shown in slicer
        "objectHeightChange": true, // if true, slightly increases the height of every other object so they show as seperate layers when viewed in the slicer

        "style": "role" // options are "role", "instruction", and "segment"
          // role: shows role of lines in slicer view
          // instruction: shows g1/g2/g3 instructions with different colors
          // segment: shows each line segment or arc as a different color
    },

    // debug settings
    "debug": {
        "showBoundingBoxes": false,
        "optimizePathOrder": true, // if false, path order will be the same as in the input file
        "profiling": false // if true, profiles the pipeline and prints the slowest functions
    }
}
