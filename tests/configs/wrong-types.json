// Every setting here has the right *name* and the wrong *type*. None of them
// should be applied - initFromJson prints a message per offender and leaves the
// field at its default. Grouped by which branch of the type checking rejects it.
{
    // --- generic type check (type(setting) != type(default)) ---
    "processing": {
        "fillSpacing": "0.3",           // str, want number
        "generateGapInfill": "true",    // str, want bool
        "prefixFile": 5,                // number, want str
        "unknownSetting": 1             // not a Settings field at all
    },
    "motion": {
        "heights": [0, 0, 10],          // list, want dict of move-type keys
        "speeds": 3000,                 // number, want dict
        "eAxisMultiplier": [1]          // list, want number
    },

    // --- the special-typed settings, each with its own shape check ---
    "machine": {
        "startPos": [0, 0],             // 2-element, want 3
        "penOffset": 5,                 // scalar, want 2-element list
        "canvasSize": [1, 2, 3],        // 3-element, want 2
        "canvasAlignment": "XY",        // not one of BL/BR/TL/TR
        "safeZoneAlignment": "bottom"   // ditto
    },
    "visualization": {
        "style": "rainbow",             // not role/instruction/segment
        "instructionTypes": ["a", "b"], // 2-element, want 4
        "segmentTypes": [1, 2, 3]       // list of numbers, want strings
    }
}
