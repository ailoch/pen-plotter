#!/bin/sh
# Runs the test suite before anything leaves the machine.
#
# The whole suite is ~40s.
#
# Enable with:   git config core.hooksPath .githooks
# Bypass once:   git push --no-verify

# Prefer the py launcher (Windows), fall back to python3/python
if command -v py >/dev/null 2>&1; then
    PY="py -3"
elif command -v python3 >/dev/null 2>&1; then
    PY="python3"
elif command -v python >/dev/null 2>&1; then
    PY="python"
else
    echo "Pre-push: no python found; skipping tests" >&2
    exit 0
fi

if ! $PY -c "import pytest" >/dev/null 2>&1; then
    echo "Pre-push: pytest not installed (pip install pytest); skipping tests" >&2
    exit 0
fi

echo "Pre-push: running tests..."
if ! $PY -m pytest -q; then
    echo >&2
    echo "Pre-push: tests failed - push aborted." >&2
    echo "  re-run with:   py -3 -m pytest" >&2
    echo "  fast only:     py -3 -m pytest -m 'not slow'" >&2
    echo "  push anyway:   git push --no-verify" >&2
    exit 1
fi
